# Runtime
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database & Persistence (Standalone local JSON database and file storage)
USE_LOCAL_DB=true
LOCAL_DB_PATH=./local_data.json
UPLOAD_DIR=./uploads

# Comma-separated allowed frontend origins (no trailing slash).
FRONTEND_ORIGIN=https://hire-sight-tau.vercel.app,http://localhost:5173

# Optional: internal service URL for distributed AI service
AI_SERVICE_URL=
